# ==========================================
# Database Configuration (Supabase PostgreSQL)
# ==========================================
# Supabase Dashboard → Project Settings → Database → Connection string
# Use Session pooler or Direct connection (port 5432).
# Do not use the transaction pooler (port 6543): Flyway and Hibernate need a session connection.
#
# Session pooler (works on IPv4):
# DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.YOUR_PROJECT_REF
#
# Direct connection:
# DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_SIZE=5

# ==========================================
# Super Admin bootstrap (created on startup if missing)
# ==========================================
SUPER_ADMIN_EMAIL=Sanju@gmail.com
SUPER_ADMIN_PASSWORD=12345678
SUPER_ADMIN_USERNAME=SanjuAdmin
SUPER_ADMIN_FULLNAME=Sanju Kumar

# ==========================================
# Spring Boot & JWT Configuration
# ==========================================
SERVER_PORT=8080
JWT_SECRET=change_this_to_a_secure_256_bit_cryptographic_secret_key_in_dev_2026
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ==========================================
# Code Execution Sandbox Configuration
# ==========================================
SANDBOX_PROVIDER=LOCAL
EXECUTION_TIMEOUT_MS=2000
MEMORY_LIMIT_MB=256
